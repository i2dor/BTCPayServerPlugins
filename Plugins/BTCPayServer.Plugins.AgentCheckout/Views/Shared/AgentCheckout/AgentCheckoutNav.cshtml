@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Client
@inject IScopeProvider ScopeProvider
@{
    var storeId = ScopeProvider.GetCurrentStoreId();
}
@if (!string.IsNullOrEmpty(storeId))
{
    <li class="nav-item">
        <a permission="@Policies.CanModifyStoreSettings" asp-controller="AgentCheckoutSettings" asp-action="UpdateSettings" asp-route-storeId="@storeId" class="nav-link @ViewData.IsActivePage("AgentCheckout")" id="Nav-AgentCheckout">
            <span>Agent Checkout</span>
        </a>
    </li>
}
